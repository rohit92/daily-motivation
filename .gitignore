# ============================================================
#  SECRETS — never commit these
# ============================================================
# Google OAuth client (real credentials)
client_secret.json
# per-channel OAuth tokens
**/yt_token.json
# API keys stored as file fallbacks
assets/youtube_api_key.txt
assets/anthropic_api_key.txt
*.pem
.env
.env.*
!.env.example

# ============================================================
#  Generated media & per-run output  (regenerable, large)
# ============================================================
channels/*/output/
channels/*/long_form/
# edge-tts / piper voice output
assets/voices/
# make_music.py output
assets/music/
*.mp4
# imagery.py stock photos — hundreds of MB, and `imagery.py --stock` rebuilds
# them from Wikimedia/Openverse on demand. manifest.json is NOT ignored: it is
# the record of which licence and which author each image carries, which is the
# part that actually matters and the part that cannot be regenerated.
assets/images/**/*.jpg
assets/images/**/*.jpeg
assets/images/**/*.png
!assets/images/manifest.json
*.mov
*.mkv
*.mp3
*.wav

# Recorded narration. The audio itself is covered by *.wav above. These two are
# rewritten by every `voiceover.py --sheet` run, so tracking them turns an
# ordinary week's recording into a diff. voice.json IS kept: it records which
# lines were matched and how confidently, which is the part worth keeping.
channels/*/assets/voice/RECORD_THIS.txt
channels/*/assets/voice/sheet.json

# The pilot rewrites today.json every morning with the day's pick. It is
# derived state — what actually shipped is recorded in library.json and
# schedule.json — so tracking it just adds a create/delete pair to the diff
# every single day, which is how it ended up committed and untracked by turns.
channels/*/today.json
# ...but keep small brand assets even if they are audio/img
!assets/brand/**
backups/
.work/

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ============================================================
#  OS / editor
# ============================================================
.DS_Store
